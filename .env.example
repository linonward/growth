# PostHog — Phase 0 experiment analytics (P0-EXP-01)
#
# Leave these unset to run without analytics: every tracker becomes a no-op and
# the app works normally. The local event log + /debug/export still work.
#
# Create a project at https://posthog.com, then copy the project API key.
# The key is public by design (it only allows event ingestion).
NEXT_PUBLIC_POSTHOG_KEY=
# EU or US ingestion host. Defaults to https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# NOTE: do NOT add any variable holding a participant's real identity.
# The prototype identifies participants only by an anonymous local UUID, and the
# only person properties are experiment_version and age_band. The age band is
# recorded per device by the experimenter in the ?debug=1 panel and is one school
# year wide (6-7 … 11-12) — never a birth date. See src/domain/age-band.ts.
